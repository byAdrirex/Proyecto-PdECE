---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Calendario Académico · Planificador Académico UMSS">
  <section class="content-page">
    <a class="back-link" href="/">← Volver a la malla</a>
    <header class="page-heading">
      <p class="eyebrow">Información institucional</p>
      <h1>Calendario Académico</h1>
      <p>Consulta las fechas académicas en el documento oficial.</p>
    </header>
    <div class="calendar-image-container">
      <img
        src="https://www.fce.umss.edu.bo/webpage/sites/default/files/inline-images/Calendario%20Academico%20FCE%20II-2026_.jpg"
        alt="Calendario Académico FCE II-2026"
        class="calendar-image"
      />
    </div>
  </section>
</AppLayout>
